{
  "name": "knowledge-mcp",
  "version": "1.0.0",
  "description": "MCP server that gives AI agents read and write access to a shared knowledge store. Every write passes one screening gate that blocks listed patterns, holds what it cannot judge for a reviewer, and audits each decision.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "main": "src/index.js",
  "exports": {
    ".": "./src/server.js",
    "./web": "./web/client.js",
    "./screening": "./src/screening/screen.js"
  },
  "bin": {
    "knowledge-mcp": "src/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "check": "node src/index.js --check",
    "test": "node --test test/*.test.js",
    "demo": "node scripts/demo.mjs",
    "demo:safety": "node scripts/safety-demo.mjs",
    "examples": "node examples/run.mjs",
    "eval:legacy": "node eval/legacy.mjs",
    "eval:heldout": "node eval/run.mjs",
    "eval:dev": "node eval/dev-probes.mjs",
    "eval:public": "node eval/public.mjs",
    "bench": "node scripts/bench.mjs",
    "console": "node web/console/server.js",
    "corpus:check": "python3 corpus/public/fetch.py --check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "^4.4.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agent-memory",
    "knowledge-store",
    "deny-list",
    "human-review"
  ],
  "files": [
    "src/",
    "web/",
    "config/",
    "data/",
    "README.md",
    "LICENSE",
    "corpus/public/"
  ]
}
