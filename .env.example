# All optional. With nothing set, the server runs on an in-memory store
# seeded from data/seed.json and screens writes with config/deny-list.example.json.

# Persist the store to a JSON file instead of memory.
# KNOWLEDGE_STORE_PATH=./data/store.local.json

# Seed file loaded at startup (through the screening gate). "none" disables seeding.
# KNOWLEDGE_SEED=./data/seed.json

# Deny-list JSON file. Startup fails if the file is missing, empty, invalid, or has a pattern that is slow on long input.
# DENY_LIST_PATH=./config/deny-list.example.json

# Owner id stamped on every record and memory file.
# OWNER_ID=local-owner

# commit writes what screening allows and holds what it cannot judge for a reviewer.
# dry-run screens and defers all writes, skips seeding and still writes value-free audit decisions.
KNOWLEDGE_WRITE_MODE=commit
